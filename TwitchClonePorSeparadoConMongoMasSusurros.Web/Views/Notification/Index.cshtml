@model List<dynamic>

@{
    ViewData["Title"] = "Notificaciones";
}

<div style="max-width: 600px; margin: 0 auto; padding: 2rem;">
    <h1>🔔 Notificaciones</h1>

    <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <form method="post" asp-action="MarkAllAsRead" style="display: inline;">
            <button type="submit" style="background: #9147ff; color: #fff; border: none; padding: 0.5rem 1rem; border-radius: 4px; cursor: pointer;">
                Marcar todas como leídas
            </button>
        </form>
    </div>

    @if (Model.Count == 0)
    {
        <p style="color: #999;">No tienes notificaciones.</p>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            @foreach (var notif in Model)
            {
                <div style="background: #fff; border: 1px solid #ddd; border-radius: 8px; padding: 1rem; border-left: 4px solid #9147ff;">
                    <div style="display: flex; justify-content: space-between; align-items: start;">
                        <div>
                            <h3 style="margin: 0 0 0.5rem 0;">@notif.Message</h3>
                            <p style="margin: 0; color: #666; font-size: 0.9rem;">@notif.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <a href="@notif.Link" style="background: #9147ff; color: #fff; padding: 0.4rem 0.8rem; border-radius: 4px; text-decoration: none; font-size: 0.85rem;">
                            Ver
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>