@model List<TwitchClonePorSeparadoConMongoMasSusurros.Domain.Models.Category>

@{
    ViewData["Title"] = "Categorías";
    var allTags = Model?
        .SelectMany(c => c.CategoryTags.Select(ct => ct.Tag))
        .Where(t => t != null)
        .DistinctBy(t => t!.Id)
        .OrderBy(t => t!.Name)
        .ToList() ?? new();
}

<div style="max-width: 1100px; margin: 0 auto; padding: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h1 style="margin: 0;">🗂️ Categorías</h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Category" asp-action="Create"
               style="background:#9147ff; color:#fff; text-decoration:none; padding:0.5rem 1rem; border-radius:6px; font-size:0.9rem; font-weight:600;">
                + Nueva categoría
            </a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <p style="color:#3fb950; margin-bottom:1rem;">@TempData["Success"]</p>
    }

    @if (allTags.Count > 0)
    {
        <div id="tag-filters" style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-bottom:1.5rem;">
            <button type="button" class="tag-filter-btn active" data-tag="all"
                    style="background:#9147ff; color:#fff; border:none; border-radius:20px; padding:0.35rem 0.9rem; font-size:0.8rem; cursor:pointer;">
                Todas
            </button>
            @foreach (var tag in allTags)
            {
                <button type="button" class="tag-filter-btn" data-tag="@tag!.Id"
                        style="background:#18181b; color:#adadb8; border:1px solid #2a2a2e; border-radius:20px; padding:0.35rem 0.9rem; font-size:0.8rem; cursor:pointer;">
                    @tag.Name
                </button>
            }
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <p style="color: #999;">Aún no hay categorías.</p>
    }
    else
    {
        <div id="category-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
            @foreach (var category in Model)
            {
                var tagIds = string.Join(",", category.CategoryTags.Select(ct => ct.TagId));
                <a asp-controller="Category" asp-action="Detail" asp-route-id="@category.Id"
                   class="category-card" data-tags="@tagIds"
                   style="text-decoration: none; color: inherit;">
                    <div style="border: 1px solid #2a2a2e; border-radius: 8px; overflow: hidden; background:#18181b;">
                        <div style="height: 140px; background:#0e0e10; display:flex; align-items:center; justify-content:center; color:#666; font-size:2.5rem;">
                            @if (!string.IsNullOrEmpty(category.ImageUrl))
                            {
                                <img src="@category.ImageUrl" alt="@category.Name" style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <span>🎮</span>
                            }
                        </div>
                        <div style="padding: 0.75rem 1rem;">
                            <h3 style="margin: 0 0 0.25rem 0;">@category.Name</h3>
                            <p style="margin: 0 0 0.5rem 0; color: #999; font-size: 0.85rem;">@category.Description</p>
                            @if (category.CategoryTags.Any())
                            {
                                <div style="display:flex; flex-wrap:wrap; gap:0.3rem;">
                                    @foreach (var ct in category.CategoryTags)
                                    {
                                        <span style="background:#0e0e10; color:#9147ff; border-radius:10px; padding:0.15rem 0.55rem; font-size:0.7rem;">
                                            @ct.Tag?.Name
                                        </span>
                                    }
                                </div>
                            }
                            @if (category.SubCategories != null && category.SubCategories.Any())
                            {
                                <p style="margin: 0.5rem 0 0 0; color:#666; font-size: 0.75rem;">
                                    @category.SubCategories.Count juego@(category.SubCategories.Count == 1 ? "" : "s") dentro
                                </p>
                            }
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.tag-filter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tag-filter-btn').forEach(b => {
                    b.style.background = '#18181b';
                    b.style.color = '#adadb8';
                    b.style.border = '1px solid #2a2a2e';
                });
                btn.style.background = '#9147ff';
                btn.style.color = '#fff';
                btn.style.border = 'none';

                const tagId = btn.dataset.tag;
                document.querySelectorAll('.category-card').forEach(card => {
                    if (tagId === 'all') {
                        card.style.display = '';
                        return;
                    }
                    const cardTags = (card.dataset.tags || '').split(',');
                    card.style.display = cardTags.includes(tagId) ? '' : 'none';
                });
            });
        });
    </script>
}

