@{
    ViewData["Title"] = "Mis puntos";
}

<div style="max-width: 600px; margin: 3rem auto; padding: 2rem; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
    <h1>💜 Mis puntos</h1>
    <p style="font-size: 2rem; color: #9147ff; font-weight: 700; text-align: center;">@ViewBag.Points puntos</p>

    @if (TempData["Success"] != null)
    {
        <div style="background: #c8e6c9; color: #2e7d32; padding: 1rem; border-radius: 4px; margin-bottom: 1rem; text-align: center;">
            ✅ @TempData["Success"]
        </div>
    }

    <form method="post" asp-action="AddPoints" style="display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem;">
        @Html.AntiForgeryToken()

        <div>
            <label style="font-weight: 600;">¿Cuántos puntos quieres comprar?</label>
            <select name="amount" required style="width: 100%; padding: 0.8rem; border: 1px solid #ddd; border-radius: 4px; font-family: inherit;">
                <option value="100">100 puntos</option>
                <option value="500">500 puntos</option>
                <option value="1000">1000 puntos</option>
                <option value="5000">5000 puntos</option>
            </select>
        </div>

        <button type="submit" style="background: #9147ff; color: #fff; border: none; padding: 0.8rem; border-radius: 4px; font-weight: 600; cursor: pointer;">
            💜 Comprar puntos
        </button>
    </form>
</div>