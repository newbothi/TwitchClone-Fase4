@using TwitchClonePorSeparadoConMongoMasSusurros.Domain.Models
@model TwitchClonePorSeparadoConMongoMasSusurros.Domain.DTOs.EditProfileDto

@{
    ViewData["Title"] = "Editar perfil";
    var currentUser = ViewBag.User as AppUser;
    var socialLinks = ViewBag.SocialLinks as List<SocialLink> ?? new();
}

<div class="edit-profile-wrapper">

    @if (TempData["Success"] != null)
    {
        <div class="edit-alert success">@TempData["Success"]</div>
    }
    @if (TempData["ProfileImageError"] != null)
    {
        <div class="edit-alert error">@TempData["ProfileImageError"]</div>
    }
    @if (TempData["SocialLinkError"] != null)
    {
        <div class="edit-alert error">@TempData["SocialLinkError"]</div>
    }

    <!-- Vista previa: banner + avatar superpuesto, igual que la pantalla real de Twitch -->
    <div class="edit-preview">
        @if (!string.IsNullOrEmpty(currentUser?.BannerUrl))
        {
            <img src="@currentUser.BannerUrl" alt="Banner" class="edit-preview-banner" />
        }
        else
        {
            <div class="edit-preview-banner edit-preview-banner-empty"></div>
        }

        <div class="edit-preview-avatar">
            @if (!string.IsNullOrEmpty(currentUser?.AvatarUrl))
            {
                <img src="@currentUser.AvatarUrl" alt="Avatar" />
            }
            else
            {
                <span>@(currentUser?.DisplayUsername.Length > 0 ? currentUser.DisplayUsername[0].ToString().ToUpper() : "?")</span>
            }
        </div>
    </div>

    <!-- Foto de perfil -->
    <div class="edit-section">
        <div class="edit-row">
            <div>
                <h3>Foto de perfil</h3>
                <p class="edit-hint">JPEG, PNG o GIF inferior a 10 MB</p>
            </div>
            <label class="edit-icon-btn" for="avatar-input">✏️</label>
        </div>
        <form asp-controller="User" asp-action="UploadAvatar" method="post" enctype="multipart/form-data" id="avatar-form">
            @Html.AntiForgeryToken()
            <input type="file" id="avatar-input" name="image" accept="image/jpeg,image/png,image/gif" style="display:none;"
                   onchange="document.getElementById('avatar-form').submit();" />
        </form>
    </div>

    <!-- Banner de perfil -->
    <div class="edit-section">
        <div class="edit-row">
            <div>
                <h3>Banner de perfil</h3>
                <p class="edit-hint">Recomendado: 1200 x 480 e inferior a 10 MB</p>
            </div>
            <label class="edit-icon-btn" for="banner-input">✏️</label>
        </div>
        <form asp-controller="User" asp-action="UploadBanner" method="post" enctype="multipart/form-data" id="banner-form">
            @Html.AntiForgeryToken()
            <input type="file" id="banner-input" name="image" accept="image/jpeg,image/png,image/gif" style="display:none;"
                   onchange="document.getElementById('banner-form').submit();" />
        </form>
        <p class="edit-hint">Personaliza tu aspecto visual y el de tu canal en TwitchClone.</p>
    </div>

    <!-- Acerca de -->
    <div class="edit-section">
        <h2 class="edit-section-title">ACERCA DE</h2>

        <form asp-controller="User" asp-action="EditProfile" method="post">
            @Html.AntiForgeryToken()

            <div class="edit-field">
                <label>Nombre de usuario</label>
                <p class="edit-readonly">@currentUser?.UserName</p>
            </div>

            <div class="edit-field">
                <label asp-for="DisplayUsername">Nombre público</label>
                <input asp-for="DisplayUsername" class="edit-input" />
                <span asp-validation-for="DisplayUsername" class="edit-error"></span>
            </div>

            <div class="edit-field">
                <label asp-for="Bio">Biografía</label>
                <textarea asp-for="Bio" class="edit-input" rows="4" placeholder="Cuéntale a la comunidad sobre ti..."></textarea>
                <span asp-validation-for="Bio" class="edit-error"></span>
            </div>

            <button type="submit" class="edit-save-btn">Guardar cambios</button>
        </form>
    </div>

    <!-- Enlaces sociales -->
    <div class="edit-section">
        <h2 class="edit-section-title">ENLACES SOCIALES</h2>
        <p class="edit-hint">
            Añade hasta 5 enlaces sociales que se mostrarán en tu perfil. Los espectadores también podrán encontrarte de esta forma.
        </p>

        @if (socialLinks.Any())
        {
            <div class="social-link-list">
                @foreach (var link in socialLinks)
                {
                    <div class="social-link-row">
                        <div>
                            <strong>@link.Title</strong>
                            <span class="edit-hint">@link.Url</span>
                        </div>
                        <form asp-controller="User" asp-action="DeleteSocialLink" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@link.Id" />
                            <button type="submit" class="social-link-delete" title="Eliminar">🗑️</button>
                        </form>
                    </div>
                }
            </div>
        }

        @if (socialLinks.Count < 5)
        {
            <details class="add-social-link">
                <summary>+ Añadir enlace social</summary>
                <form asp-controller="User" asp-action="AddSocialLink" method="post" class="edit-field" style="margin-top:1rem;">
                    @Html.AntiForgeryToken()
                    <label>Título</label>
                    <input type="text" name="title" class="edit-input" placeholder="Texto mostrado para el enlace" maxlength="50" required />

                    <label style="margin-top:0.75rem; display:block;">Vincular URL</label>
                    <input type="url" name="url" class="edit-input" placeholder="https://" required />
                    <p class="edit-hint">¿Dónde debe ir el enlace? Escribe la URL completa, así: https://twitter.com/twitchclone</p>

                    <button type="submit" class="edit-save-btn" style="margin-top:0.5rem;">Guardar</button>
                </form>
            </details>
        }
        else
        {
            <p class="edit-hint">Ya tienes el máximo de 5 enlaces sociales.</p>
        }
    </div>

</div>

@section Styles {
    <style>
        .edit-profile-wrapper {
            max-width: 640px;
            margin: 0 auto;
            padding: 2rem;
        }

        .edit-alert {
            padding: 0.75rem 1rem;
            border-radius: 6px;
            font-size: 0.9rem;
            margin-bottom: 1.25rem;
        }

            .edit-alert.success {
                background: rgba(63, 185, 80, 0.1);
                border: 1px solid #3fb950;
                color: #3fb950;
            }

            .edit-alert.error {
                background: rgba(255, 107, 107, 0.1);
                border: 1px solid #ff6b6b;
                color: #ff6b6b;
            }

        .edit-preview {
            position: relative;
            margin-bottom: 4rem;
        }

        .edit-preview-banner {
            width: 100%;
            height: 160px;
            object-fit: cover;
            border-radius: 10px;
            display: block;
        }

        .edit-preview-banner-empty {
            background: linear-gradient(135deg, #2a2a2e, #18181b);
        }

        .edit-preview-avatar {
            position: absolute;
            left: 50%;
            bottom: -40px;
            transform: translateX(-50%);
            width: 90px;
            height: 90px;
            border-radius: 50%;
            border: 4px solid #0e0e10;
            background: #9147ff;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 2rem;
            font-weight: 700;
        }

            .edit-preview-avatar img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .edit-section {
            background: #18181b;
            border: 1px solid #2a2a2e;
            border-radius: 10px;
            padding: 1.5rem;
            margin-bottom: 1.25rem;
        }

        .edit-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .edit-row h3 {
                color: #efeff1;
                font-size: 1rem;
                margin: 0 0 0.25rem 0;
            }

        .edit-hint {
            color: #adadb8;
            font-size: 0.8rem;
            margin: 0;
        }

        .edit-icon-btn {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #2a2a2e;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            flex-shrink: 0;
        }

        .edit-section-title {
            color: #adadb8;
            font-size: 0.8rem;
            letter-spacing: 0.05em;
            margin: 0 0 1rem 0;
        }

        .edit-field {
            margin-bottom: 1.1rem;
        }

            .edit-field label {
                display: block;
                color: #adadb8;
                font-size: 0.8rem;
                font-weight: 600;
                margin-bottom: 0.35rem;
            }

        .edit-readonly {
            color: #adadb8;
            font-size: 0.9rem;
            margin: 0;
        }

        .edit-input {
            width: 100%;
            box-sizing: border-box;
            background: #0e0e10;
            border: 1px solid #2a2a2e;
            color: #efeff1;
            padding: 0.6rem 0.75rem;
            border-radius: 6px;
            font-size: 0.9rem;
            font-family: inherit;
        }

            .edit-input:focus {
                outline: none;
                border-color: #9147ff;
            }

        .edit-error {
            color: #ff6b6b;
            font-size: 0.8rem;
        }

        .edit-save-btn {
            background: #9147ff;
            color: #fff;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
        }

        .social-link-list {
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
            margin-bottom: 1rem;
        }

        .social-link-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #0e0e10;
            border: 1px solid #2a2a2e;
            border-radius: 6px;
            padding: 0.65rem 0.9rem;
        }

            .social-link-row strong {
                display: block;
                color: #efeff1;
                font-size: 0.9rem;
            }

            .social-link-row .edit-hint {
                word-break: break-all;
            }

        .social-link-delete {
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 1rem;
            flex-shrink: 0;
        }

        .add-social-link summary {
            color: #9147ff;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
