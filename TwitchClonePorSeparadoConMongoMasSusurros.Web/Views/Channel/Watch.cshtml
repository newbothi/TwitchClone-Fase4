@model TwitchClonePorSeparadoConMongoMasSusurros.Domain.DTOs.ChannelDto

@{
    ViewData["Title"] = Model.Name;
    // JSON generado por ChannelController.Watch (WatchPageConfig). System.Text.Json escapa
    // < > & por defecto, así que es seguro incrustarlo dentro de <script type="application/json">.
    var watchConfigJson = (string)(ViewBag.WatchConfigJson ?? "{}");
}

<div class="watch-wrapper">

    <!-- Columna izquierda: player + info -->
    <div class="watch-main">

        <!-- Player HLS -->
        <div class="player-wrapper">
            @if (Model.IsLive)
            {
                <video id="video-player" controls autoplay muted style="width:100%;height:100%;"></video>
                @* Alertas del stream (follows y donaciones), como las que pone OBS encima del video. *@
                <div id="stream-alert" class="stream-alert" aria-live="polite" hidden></div>
            }
            else
            {
                <div class="offline-screen">
                    <div class="offline-pattern"></div>

                    <div class="offline-card">
                        <span class="offline-badge">DESCONECTADO</span>
                        <h2 class="offline-title">@Model.DisplayUsername no está transmitiendo ahora mismo.</h2>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p class="offline-description">@Model.Description</p>
                        }

                        <div class="offline-meta">
                            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
                            {
                                <span>🗂️ @Model.CategoryName</span>
                            }
                            <span>👥 @ViewBag.FollowerCount seguidores</span>
                        </div>

                        @if (ViewBag.IsOwnChannel == true)
                        {
                            <p class="offline-own-hint">
                                Este es tu canal. Abre OBS y empieza a transmitir para que aparezca en vivo aquí.
                            </p>
                        }
                        else if (User.Identity!.IsAuthenticated)
                        {
                            @if (ViewBag.IsFollowing == true)
                            {
                                <form asp-controller="User" asp-action="Unfollow" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="followedId" value="@Model.UserId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="offline-follow-btn following">✓ Siguiendo</button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="User" asp-action="Follow" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="followedId" value="@Model.UserId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="offline-follow-btn">💜 Seguir</button>
                                </form>
                            }
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="offline-follow-btn" style="text-decoration:none; display:inline-block;">
                                Inicia sesión para seguir
                            </a>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Info del canal -->
        <div class="channel-meta">
            <div class="channel-meta-left">
                <div class="meta-avatar">
                    @Model.DisplayUsername[0].ToString().ToUpper()
                </div>
                <div>
                    <h1>@Model.Name</h1>
                    <p>
                        <a asp-controller="User" asp-action="Profile"
                           asp-route-username="@Model.UserName"
                           style="color:#adadb8; text-decoration:none;">
                            @Model.DisplayUsername
                        </a>
                    </p>
                </div>
            </div>
            <div class="channel-meta-right">
                @if (Model.IsLive)
                {
                    <span class="live-pill">🔴 EN VIVO</span>
                    <span class="viewer-pill" id="viewer-pill" style="cursor:pointer;" title="Ver quién está mirando">
                        👁 <span id="viewer-count">@Model.ViewerCount</span>
                    </span>
                }
                else
                {
                    <span class="offline-pill">⚫ OFFLINE</span>
                }

                @if (User.Identity!.IsAuthenticated)
                {
                    <a asp-controller="Donation" asp-action="Channel" asp-route-id="@Model.Id"
                       class="donate-btn">💰 Donar</a>

                    @if (Model.IsLive)
                    {
                        <form asp-controller="Clip" asp-action="Create" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="channelId" value="@Model.Id" />
                            <input type="hidden" name="title" id="clip-title" value="" />
                            <button type="submit" class="btn-clip"
                                    onclick="document.getElementById('clip-title').value = 'Clip ' + new Date().toLocaleTimeString()">
                                ✂️ Clip
                            </button>
                        </form>
                    }

                    <a asp-controller="Clip" asp-action="Channel" asp-route-id="@Model.Id"
                       class="btn-clip">
                        📼 Clips
                    </a>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="channel-description">
                <p>@Model.Description</p>
            </div>
        }
    </div>

    <!-- Columna derecha: chat -->
    <div class="chat-wrapper">
        <div class="chat-header">💬 Chat en vivo</div>

        @* Todo lo de abajo lo llena wwwroot/js/watch.js con textContent (nunca innerHTML). *@
        <div id="chat-raid" class="chat-raid" hidden></div>
        <div id="chat-pinned" class="chat-pinned" hidden></div>
        <div id="chat-poll" class="chat-poll" hidden></div>
        <div id="chat-automod" class="chat-automod" hidden></div>

        <div class="chat-messages-area">
            <div class="chat-messages" id="chat-messages" role="log" aria-live="polite"></div>
            <button type="button" id="chat-new-messages" class="chat-new-messages" hidden>Mensajes nuevos ↓</button>
        </div>

        <div id="chat-modes" class="chat-modes" hidden></div>

        @if (User.Identity!.IsAuthenticated)
        {
            <div id="chat-reply" class="chat-reply-bar" hidden>
                <span id="chat-reply-text"></span>
                <button type="button" id="chat-reply-cancel" class="chat-reply-cancel" aria-label="Cancelar respuesta">✕</button>
            </div>
            <div class="chat-input-wrapper">
                <input type="text" id="chat-input" class="chat-input"
                       placeholder="Envía un mensaje o escribe /help" maxlength="500" autocomplete="off" />
                <button id="chat-send" class="chat-send-btn">Enviar</button>
            </div>
            <div class="chat-footer">
                <span id="chat-points" class="chat-points" title="Puntos del canal: se ganan viendo streams en vivo" hidden></span>
                <span class="chat-hint">/help para ver comandos</span>
            </div>
        }
        else
        {
            <div class="chat-login-prompt">
                <a asp-controller="Account" asp-action="Login">Inicia sesión</a> para chatear
            </div>
        }
    </div>

</div>

<!-- Modal: tarjeta de usuario (clic en un nombre del chat) -->
<div id="user-card-modal" class="viewers-modal-overlay" style="display:none;">
    <div class="viewers-modal user-card">
        <div class="viewers-modal-header">
            <h3>Usuario</h3>
            <button type="button" id="user-card-close" class="viewers-modal-close" aria-label="Cerrar">&times;</button>
        </div>
        <div id="user-card-body" class="user-card-body"></div>
    </div>
</div>

<!-- Modal: reglas del chat (la primera vez que vas a escribir) -->
<div id="rules-modal" class="viewers-modal-overlay" style="display:none;">
    <div class="viewers-modal user-card">
        <div class="viewers-modal-header">
            <h3>📜 Reglas del chat</h3>
        </div>
        <div class="user-card-body">
            <p id="rules-text" class="rules-text"></p>
            <button type="button" id="rules-accept" class="chat-send-btn" style="width:100%;">Acepto</button>
        </div>
    </div>
</div>

<!-- Modal: lista de viewers conectados -->
<div id="viewers-modal" class="viewers-modal-overlay" style="display:none;">
    <div class="viewers-modal">
        <div class="viewers-modal-header">
            <h3>👁 Viendo ahora (<span id="viewers-modal-count">0</span>)</h3>
            <button type="button" id="viewers-modal-close" class="viewers-modal-close">&times;</button>
        </div>
        <div id="viewers-modal-list" class="viewers-modal-list">
            <p class="viewers-empty">Cargando...</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .watch-wrapper {
            display: grid;
            grid-template-columns: 1fr 340px;
            height: calc(100vh - 50px);
            overflow: hidden;
        }

        .watch-main {
            overflow-y: auto;
        }

        .player-wrapper {
            background: #000;
            aspect-ratio: 16/9;
            width: 100%;
            position: relative;
        }

        .stream-alert {
            position: absolute;
            top: 8%;
            left: 50%;
            transform: translateX(-50%);
            max-width: 80%;
            background: rgba(14, 14, 16, 0.88);
            border: 2px solid #9147ff;
            border-radius: 10px;
            padding: 0.7rem 1.2rem;
            text-align: center;
            pointer-events: none;
            box-shadow: 0 6px 24px rgba(145, 71, 255, 0.35);
            animation: stream-alert-in 0.35s ease-out;
        }

            .stream-alert.donation {
                border-color: #3fb950;
                box-shadow: 0 6px 24px rgba(63, 185, 80, 0.35);
            }

            .stream-alert .alert-title {
                font-weight: 800;
                font-size: 1.1rem;
            }

            .stream-alert .alert-message {
                margin-top: 0.25rem;
                color: #dedee3;
                font-size: 0.9rem;
                overflow-wrap: anywhere;
            }

        @@keyframes stream-alert-in {
            from { opacity: 0; transform: translate(-50%, -12px) scale(0.96); }
            to { opacity: 1; transform: translate(-50%, 0) scale(1); }
        }

        .offline-screen {
            width: 100%;
            height: 100%;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #18181b;
        }

        .offline-pattern {
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(#2a2a2e 1px, transparent 1px),
                linear-gradient(90deg, #2a2a2e 1px, transparent 1px);
            background-size: 28px 28px;
            opacity: 0.4;
        }

        .offline-card {
            position: relative;
            z-index: 1;
            background: #0e0e10;
            border: 1px solid #2a2a2e;
            border-radius: 10px;
            padding: 2rem 2.5rem;
            max-width: 420px;
            text-align: center;
        }

        .offline-badge {
            display: inline-block;
            background: #3a3a3e;
            color: #efeff1;
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            padding: 0.25rem 0.6rem;
            border-radius: 4px;
            margin-bottom: 1rem;
        }

        .offline-title {
            color: #efeff1;
            font-size: 1.1rem;
            margin: 0 0 0.75rem 0;
        }

        .offline-description {
            color: #adadb8;
            font-size: 0.9rem;
            margin: 0 0 1rem 0;
        }

        .offline-meta {
            display: flex;
            justify-content: center;
            gap: 1rem;
            color: #adadb8;
            font-size: 0.8rem;
            margin-bottom: 1.5rem;
        }

        .offline-own-hint {
            color: #9147ff;
            font-size: 0.85rem;
            margin: 0;
        }

        .offline-follow-btn {
            background: #9147ff;
            color: #fff;
            border: none;
            padding: 0.6rem 1.5rem;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
        }

            .offline-follow-btn.following {
                background: #2a2a2e;
                color: #efeff1;
            }

            .offline-follow-btn:hover {
                opacity: 0.9;
            }

        .channel-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 1rem 1.5rem;
            border-bottom: 1px solid #2a2a2e;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .channel-meta-left {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .meta-avatar {
            width: 48px;
            height: 48px;
            background: #9147ff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 1.2rem;
        }

        .channel-meta h1 {
            font-size: 1rem;
            margin: 0 0 0.2rem;
            color: #efeff1;
        }

        .channel-meta p {
            font-size: 0.85rem;
            color: #adadb8;
            margin: 0;
        }

        .channel-meta-right {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .live-pill {
            background: #e91916;
            color: #fff;
            padding: 0.3rem 0.6rem;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 700;
        }

        .offline-pill {
            background: #2a2a2e;
            color: #adadb8;
            padding: 0.3rem 0.6rem;
            border-radius: 4px;
            font-size: 0.8rem;
        }

        .viewer-pill {
            color: #adadb8;
            font-size: 0.85rem;
        }

        .donate-btn {
            background: #9147ff;
            color: #fff;
            padding: 0.4rem 0.9rem;
            border-radius: 5px;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .btn-clip {
            background: #2a2a2e;
            color: #efeff1;
            border: none;
            border-radius: 5px;
            padding: 0.4rem 0.9rem;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }

            .btn-clip:hover {
                background: #3a3a3e;
            }

        .channel-description {
            padding: 1rem 1.5rem;
            color: #adadb8;
            font-size: 0.9rem;
            border-bottom: 1px solid #2a2a2e;
        }

        .chat-wrapper {
            background: #18181b;
            border-left: 1px solid #2a2a2e;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 50px);
        }

        .chat-header {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #2a2a2e;
            font-weight: 600;
            font-size: 0.9rem;
            color: #efeff1;
        }

        .chat-messages-area {
            flex: 1;
            min-height: 0;
            position: relative;
            display: flex;
        }

        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .chat-message {
            font-size: 0.85rem;
            line-height: 1.45;
            word-break: break-word;
            padding: 0.15rem 0.3rem;
            border-radius: 4px;
            position: relative;
        }

            .chat-message:hover {
                background: #26262c;
            }

        .chat-username {
            color: #9147ff;
            margin-right: 0.35rem;
        }

        .chat-content {
            color: #efeff1;
        }

        .chat-input-wrapper {
            padding: 0.75rem;
            border-top: 1px solid #2a2a2e;
            display: flex;
            gap: 0.5rem;
        }

        .chat-input {
            flex: 1;
            background: #0e0e10;
            border: 1px solid #2a2a2e;
            border-radius: 5px;
            padding: 0.5rem 0.75rem;
            color: #efeff1;
            font-size: 0.85rem;
        }

            .chat-input:focus {
                outline: none;
                border-color: #9147ff;
            }

        .chat-send-btn {
            background: #9147ff;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 0.5rem 0.9rem;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .chat-login-prompt {
            padding: 0.75rem;
            border-top: 1px solid #2a2a2e;
            color: #adadb8;
            font-size: 0.85rem;
            text-align: center;
        }

            .chat-login-prompt a {
                color: #9147ff;
            }

        .chat-emote {
            width: 24px;
            height: 24px;
            object-fit: contain;
            vertical-align: middle;
            margin: 0 1px;
        }

        .viewers-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .viewers-modal {
            background: #18181b;
            border: 1px solid #2a2a2e;
            border-radius: 8px;
            width: 320px;
            max-height: 70vh;
            display: flex;
            flex-direction: column;
        }

        .viewers-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1rem;
            border-bottom: 1px solid #2a2a2e;
        }

            .viewers-modal-header h3 {
                margin: 0;
                font-size: 1rem;
            }

        .viewers-modal-close {
            background: transparent;
            border: none;
            color: #adadb8;
            font-size: 1.3rem;
            cursor: pointer;
            line-height: 1;
        }

        .viewers-modal-list {
            overflow-y: auto;
            padding: 0.5rem 0;
        }

        .viewer-row {
            padding: 0.5rem 1rem;
            font-size: 0.9rem;
            color: #efeff1;
        }

        .viewer-row-anon {
            color: #adadb8;
            font-style: italic;
        }

        .viewers-empty {
            color: #adadb8;
            font-size: 0.85rem;
            text-align: center;
            padding: 1rem;
        }

        /* ── Chat: insignias, moderación, mensajes de sistema ───────────── */

        .chat-badge {
            display: inline-block;
            margin-right: 0.25rem;
            font-size: 0.8rem;
            cursor: default;
        }

        .chat-username {
            margin-right: 0;
        }

        .chat-mod-actions {
            display: none;
            position: absolute;
            right: 0.25rem;
            top: 0.1rem;
            gap: 0.15rem;
            background: #18181b;
            border: 1px solid #2a2a2e;
            border-radius: 4px;
            padding: 0.05rem 0.15rem;
        }

        .chat-message:hover .chat-mod-actions {
            display: inline-flex;
        }

        .chat-mod-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            font-size: 0.8rem;
            padding: 0.1rem 0.2rem;
            border-radius: 3px;
        }

            .chat-mod-btn:hover {
                background: #3a3a3e;
            }

        .chat-system {
            color: #adadb8;
            font-style: italic;
            font-size: 0.8rem;
        }

        .chat-system-error {
            color: #ff8a8a;
        }

        .chat-deleted .chat-content {
            color: #6b6b75;
            font-style: italic;
        }

        .chat-donation {
            background: #9147ff22;
            border-left: 3px solid #9147ff;
            border-radius: 0 4px 4px 0;
            padding: 0.4rem 0.5rem;
            color: #efeff1;
        }

            .chat-donation strong {
                color: #bf94ff;
            }

        .chat-modes {
            padding: 0.35rem 0.75rem;
            font-size: 0.75rem;
            color: #bf94ff;
            border-top: 1px solid #2a2a2e;
        }

        .chat-new-messages {
            position: absolute;
            bottom: 0.6rem;
            left: 50%;
            transform: translateX(-50%);
            background: #9147ff;
            color: #fff;
            border: none;
            border-radius: 999px;
            padding: 0.3rem 0.9rem;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
        }

        .chat-send-btn:disabled,
        .chat-input:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }

        /* ── Fase 2: mensajes especiales ───────────────────────────────── */

        .chat-username { cursor: pointer; }
        .chat-username:hover { text-decoration: underline; }

        .chat-action .chat-content { font-style: italic; }

        .chat-mention {
            background: #9147ff1f;
            border-left: 3px solid #bf94ff;
            border-radius: 0 4px 4px 0;
        }

        .chat-announcement {
            background: linear-gradient(90deg, #9147ff33, #18181b);
            border-left: 3px solid #9147ff;
            border-radius: 0 6px 6px 0;
            padding: 0.4rem 0.5rem;
        }

        .chat-announcement-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: #bf94ff;
            margin-bottom: 0.15rem;
        }

        .chat-reply-ref {
            font-size: 0.72rem;
            color: #8a8a96;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .chat-system-notice { color: #c9b8ff; }
        .chat-system-warning { color: #f2c230; }
        .chat-system-whisper { color: #7fd1ff; font-style: normal; }
        .chat-system-raid { color: #ff8a3d; font-style: normal; font-weight: 600; }

        /* ── Fijado, encuesta, AutoMod, raid ───────────────────────────── */

        .chat-pinned, .chat-poll, .chat-automod, .chat-raid {
            margin: 0.5rem 0.5rem 0;
            border: 1px solid #2a2a2e;
            border-radius: 8px;
            background: #1f1f23;
            font-size: 0.8rem;
        }

        .chat-pinned { display: flex; gap: 0.5rem; align-items: flex-start; padding: 0.5rem 0.6rem; }
        .chat-pinned[hidden], .chat-poll[hidden], .chat-automod[hidden], .chat-raid[hidden] { display: none; }
        .chat-pinned-body { flex: 1; color: #efeff1; word-break: break-word; }
        .chat-pinned-close, .chat-reply-cancel { background: transparent; border: none; color: #adadb8; cursor: pointer; }

        .chat-poll { padding: 0.6rem; }
        .poll-header { display: flex; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.4rem; color: #efeff1; font-weight: 600; }
        .poll-timer { color: #bf94ff; font-variant-numeric: tabular-nums; }
        .poll-option {
            position: relative; display: flex; justify-content: space-between; width: 100%;
            background: #0e0e10; border: 1px solid #2a2a2e; border-radius: 6px; color: #efeff1;
            padding: 0.35rem 0.5rem; margin-bottom: 0.3rem; cursor: pointer; overflow: hidden; text-align: left;
        }
        .poll-option:disabled { cursor: default; }
        .poll-option.poll-voted { border-color: #9147ff; }
        .poll-option.poll-winner { border-color: #3fb950; }
        .poll-bar { position: absolute; inset: 0 auto 0 0; background: #9147ff44; transition: width 0.4s ease; }
        .poll-option-text, .poll-option-pct { position: relative; }
        .poll-option-pct { color: #adadb8; font-variant-numeric: tabular-nums; }
        .poll-footer { display: flex; justify-content: space-between; align-items: center; color: #adadb8; font-size: 0.72rem; }
        .poll-end { background: transparent; border: 1px solid #3a3a3e; color: #efeff1; border-radius: 4px; padding: 0.1rem 0.5rem; cursor: pointer; }

        .chat-automod { padding: 0.5rem 0.6rem; border-color: #f2c23055; max-height: 180px; overflow-y: auto; }
        .automod-title { color: #f2c230; font-weight: 600; margin-bottom: 0.35rem; }
        .automod-item { border-top: 1px solid #2a2a2e; padding: 0.35rem 0; }
        .automod-text { color: #efeff1; word-break: break-word; }
        .automod-meta { color: #8a8a96; font-size: 0.7rem; }
        .automod-actions { display: flex; gap: 0.35rem; margin-top: 0.25rem; }
        .automod-approve, .automod-deny { border: none; border-radius: 4px; padding: 0.15rem 0.6rem; cursor: pointer; font-size: 0.75rem; }
        .automod-approve { background: #3fb950; color: #04130a; }
        .automod-deny { background: #3a3a3e; color: #efeff1; }

        .chat-raid { padding: 0.5rem 0.6rem; border-color: #ff8a3d88; color: #ffb27a; display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
        .raid-cancel { background: transparent; border: 1px solid #ff8a3d88; color: #ffb27a; border-radius: 4px; padding: 0.1rem 0.5rem; cursor: pointer; text-decoration: none; white-space: nowrap; }

        /* ── Entrada: respuesta, puntos ────────────────────────────────── */

        .chat-reply-bar {
            display: flex; justify-content: space-between; align-items: center;
            padding: 0.35rem 0.75rem; border-top: 1px solid #2a2a2e; color: #bf94ff; font-size: 0.78rem;
        }
        .chat-reply-bar[hidden] { display: none; }
        .chat-footer { display: flex; justify-content: space-between; padding: 0 0.75rem 0.5rem; font-size: 0.72rem; color: #8a8a96; }
        .chat-points { color: #f2c230; font-weight: 600; }

        /* ── Tarjeta de usuario y reglas ───────────────────────────────── */

        .user-card { width: 340px; }
        .user-card-body { padding: 1rem; }
        .card-header { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.5rem; }
        .card-name { margin: 0; font-size: 1.15rem; }
        .card-line { margin: 0.2rem 0; color: #adadb8; font-size: 0.85rem; }
        .card-warning { color: #ff8a8a; }
        .card-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.9rem; }
        .card-btn {
            background: #2a2a2e; color: #efeff1; border: none; border-radius: 5px;
            padding: 0.35rem 0.7rem; cursor: pointer; font-size: 0.8rem; text-decoration: none;
        }
        .card-btn:hover { background: #3a3a3e; }
        .card-danger { background: #e9191633; color: #ff8a8a; }
        .rules-text { white-space: pre-wrap; color: #efeff1; font-size: 0.9rem; margin: 0 0 1rem; }
    </style>
}

@section Scripts {
    <script id="watch-config" type="application/json">@Html.Raw(watchConfigJson)</script>
    <script src="~/lib/signalr/dist/browser/signalr.min.js" asp-append-version="true"></script>
    @if (Model.IsLive)
    {
        @* hls.js 1.7.3 servido localmente (antes: CDN con @latest, que puede cambiar sin aviso). *@
        <script src="~/lib/hls.js/dist/hls.min.js" asp-append-version="true"></script>
    }
    <script src="~/js/watch.js" asp-append-version="true"></script>
}
